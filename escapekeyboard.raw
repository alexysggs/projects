end)

-- INTRO ANIMATION
task.spawn(function()
    IntroFrame.Visible = true
    IntroFrame.Position = UDim2.new(0.5, -250, 0.55, -60)
    
    local introTweenIn = TweenService:Create(IntroFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -250, 0.5, -60),
        BackgroundTransparency = 0
    })
    introTweenIn:Play()
    introTweenIn.Completed:Wait()

    task.wait(1.8)

    local introTweenOut = TweenService:Create(IntroFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, -250, 0.45, -60),
        BackgroundTransparency = 1
    })
    introTweenOut:Play()
    introTweenOut.Completed:Wait()

    IntroFrame:Destroy()
    MainFrame.Visible = true
end)
