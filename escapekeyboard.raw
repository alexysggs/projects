if PlayerGui:FindFirstChild("KeyboardScriptGUI") then
    PlayerGui.KeyboardScriptGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KeyboardScriptGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local function createStyle(parent, cornerRadius, borderThickness)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, cornerRadius or 12)
    corner.Parent = parent

    if borderThickness and borderThickness > 0 then
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = borderThickness
        stroke.Color = Color3.fromRGB(0, 0, 0)
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = parent
    end
end

