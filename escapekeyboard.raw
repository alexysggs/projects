end)

local sidebarExtended = false
ToggleSidebarBtn.MouseButton1Click:Connect(function()
    sidebarExtended = not sidebarExtended
    if sidebarExtended then
        TweenService:Create(Sidebar, TweenInfo.new(0.2), {Size = UDim2.new(0, 120, 1, -50)}):Play()
        TweenService:Create(PageContainer, TweenInfo.new(0.2), {Position = UDim2.new(0, 120, 0, 50), Size = UDim2.new(1, -125, 1, -55)}):Play()
        ToggleSidebarBtn.Text = "<<"
    else
        TweenService:Create(Sidebar, TweenInfo.new(0.2), {Size = UDim2.new(0, 60, 1, -50)}):Play()
        TweenService:Create(PageContainer, TweenInfo.new(0.2), {Position = UDim2.new(0, 60, 0, 50), Size = UDim2.new(1, -65, 1, -55)}):Play()
        ToggleSidebarBtn.Text = ">>"
    end
end)

