-- Dropdown Auto Win con trofeos
local function createDropdown(parent, position, size, defaultText, options, onSelect)
    local DropFrame = Instance.new("Frame")
    DropFrame.Size = size
    DropFrame.Position = position
    DropFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    DropFrame.ZIndex = 5
    DropFrame.Parent = parent
    createStyle(DropFrame, 14, 2)

    local MainBtn = Instance.new("TextButton")
    MainBtn.Name = "MainBtn"
    MainBtn.Size = UDim2.new(1, 0, 1, 0)
    MainBtn.BackgroundTransparency = 1
    MainBtn.Font = Enum.Font.GothamBold
    MainBtn.Text = defaultText .. "   >"
    MainBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    MainBtn.TextSize = 13
    MainBtn.ZIndex = 6
    MainBtn.Parent = DropFrame

    local ScrollList = Instance.new("ScrollingFrame")
    ScrollList.Size = UDim2.new(1, 0, 0, 130)
    ScrollList.Position = UDim2.new(0, 0, 1, 5)
    ScrollList.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ScrollList.Visible = false
    ScrollList.BorderSizePixel = 0
    ScrollList.ScrollBarThickness = 4
    ScrollList.ZIndex = 10
    ScrollList.Parent = DropFrame
    createStyle(ScrollList, 10, 2)

    local UIList = Instance.new("UIListLayout")
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Parent = ScrollList

    for _, optionName in ipairs(options) do
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Size = UDim2.new(1, 0, 0, 28)
        ItemBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ItemBtn.Font = Enum.Font.GothamMedium
        ItemBtn.Text = optionName
        ItemBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        ItemBtn.TextSize = 12
        ItemBtn.ZIndex = 11
        ItemBtn.Parent = ScrollList

        ItemBtn.MouseButton1Click:Connect(function()
            MainBtn.Text = optionName .. "   >"
            ScrollList.Visible = false
            onSelect(optionName)
        end)
    end

    ScrollList.CanvasSize = UDim2.new(0, 0, 0, #options * 28)

    MainBtn.MouseButton1Click:Connect(function()
        ScrollList.Visible = not ScrollList.Visible
    end)

    return DropFrame
end

local w1Keys = {"Desactivado", "W1 +1", "W1 +3", "W1 +10", "W1 +20", "W1 +50", "W1 +100", "W1 +150", "W1 +300", "W1 +500", "W1 +1k", "W1 +2.5k", "W1 +10k", "W1 +25k", "W1 +50k", "W1 +150k"}

local function toggleAutoWin(selected)
    if selected == "Desactivado" then
        autoWinActive = false
        currentTargetPos = nil
    else
        if TeleportLocations[selected] then
            currentTargetPos = TeleportLocations[selected]
            autoWinActive = true
        end
    end
end

local autoWinDropdown = createDropdown(TopBox, UDim2.new(0.04, 0, 0, 50), UDim2.new(0.42, 0, 0, 38), "Desactivado", w1Keys, toggleAutoWin)

-- Bucle Auto Win Continuo (Mantiene el TP al trofeo seleccionado)
task.spawn(function()
    while true do
        task.wait(0.1)
        if autoWinActive and currentTargetPos then
            instantTeleport(currentTargetPos)
        end
    end
end)

